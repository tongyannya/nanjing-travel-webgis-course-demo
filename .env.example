# Copy this file to .env and fill in local values.
# Never commit the real .env file or paste real keys into documentation.

# AMap Web end (JS API) key. This key is used by the browser map loader.
VITE_AMAP_JS_KEY=

# securityJsCode paired with the Web end (JS API) key.
# Keep it on the backend and proxy AMap requests in the formal implementation.
AMAP_JS_SECURITY_CODE=

# AMap Web Service API key. This is used only by the backend.
AMAP_WEB_SERVICE_KEY=

# QWeather daily forecast (10 days). Backend only; never prefix with VITE_.
# Copy your account's API Host from the QWeather console, without https://.
QWEATHER_API_HOST=
QWEATHER_API_KEY=

# Agreed local development addresses.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
FRONTEND_PREVIEW_PORT=4173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Leave empty for same-origin /api; the dev server proxies to BACKEND_HOST/BACKEND_PORT.
# Set an explicit URL only when the browser API uses a different address.
VITE_API_BASE_URL=
